# --- Telegram API (получить на https://my.telegram.org) ---
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890

# --- Отдельный аккаунт-бот (НЕ основной!) ---
# Формат: +353XXXXXXXXX (с плюсом, код страны)
PHONE=+353XXXXXXXXX

# --- Откуда брать ---
# Публичный канал: @username канала (без https://t.me/)
SOURCE_CHANNEL=@channel_username

# --- Куда пересылать ---
# Варианты:
#   me                  -> в Избранное отдельного аккаунта (для теста)
#   @your_main_username -> тебе в личку с основного аккаунта (рекомендую)
#   123456789           -> по числовому ID (узнать у @userinfobot)
TARGET_CHAT=me

# --- Фильтр по ключевым словам ---
# Через запятую, регистр не важен. Сообщение перешлётся, если содержит ЛЮБОЕ слово.
# Оставь пустым, чтобы пересылать всё подряд.
KEYWORDS=вакансия,работа,требуется,ищем,зарплата,соискатель

# --- Прочее ---
SESSION_FILE=data/bot.session
LOG_LEVEL=INFO
